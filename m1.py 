#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
X1000 V2.4 — M1 : STATISTIQUES ET PERFORMANCES

Moteur sportif indépendant.

Critères :
- Forme
- Régularité
- Distance
- Parcours
- Performance

Sécurité :
- Courses françaises vérifiées par le noyau.
- Départ futur et partants contrôlés par le noyau.
- Aucune donnée sportive inventée.
- Aucune prédiction complète sans données suffisantes.
- Aucun FIGÉ automatique ou rétroactif.
- Aucune collecte PMU.
- Aucune publication automatique.
- Aucune modification des archives.

Commandes :
python -m moteurs.m1 --self-test
python -m moteurs.m1 --input courses.json
"""

from __future__ import annotations

import copy
import math
import sys

from typing import Any


# ============================================================
# 1. IDENTITÉ ET CONFIGURATION
# ============================================================

MOTEUR = "M1"
VERSION = "2.4"
CHAMP = "statistiques"

COUVERTURE_MIN = 1.0

# Configuration de référence non modifiable en place.
_POIDS_REFERENCE = (
    ("forme", 0.20),
    ("regularite", 0.20),
    ("distance", 0.20),
    ("parcours", 0.20),
    ("performance", 0.20),
)

POIDS = dict(_POIDS_REFERENCE)
CRITERES = tuple(POIDS)

STATUTS_AUTORISES = frozenset({
    "ANALYSE_DISPONIBLE",
    "DONNEES_INSUFFISANTES",
    "NON_ANALYSABLE",
})


# ============================================================
# 2. IMPORT DU NOYAU COMMUN
# ============================================================

if __package__:
    from .noyau_commun import (
        VERSION as VERSION_NOYAU,
        analyser_course as analyse_commune,
        executer,
    )
else:
    from noyau_commun import (
        VERSION as VERSION_NOYAU,
        analyser_course as analyse_commune,
        executer,
    )


# ============================================================
# 3. VALIDATION DE LA CONFIGURATION
# ============================================================

def verifier_configuration() -> None:
    """Vérifie l'identité et les paramètres M1."""

    if MOTEUR != "M1":
        raise RuntimeError("Identité M1 incorrecte")

    if VERSION != "2.4":
        raise RuntimeError("Version M1 incorrecte")

    if CHAMP != "statistiques":
        raise RuntimeError("Champ M1 incorrect")

    if (
        type(COUVERTURE_MIN) not in (int, float)
        or not math.isfinite(COUVERTURE_MIN)
        or not 0 < COUVERTURE_MIN <= 1
    ):
        raise RuntimeError(
            "Couverture minimale invalide"
        )

    if POIDS != dict(_POIDS_REFERENCE):
        raise RuntimeError(
            "Configuration M1 modifiée"
        )

    if len(CRITERES) != 5:
        raise RuntimeError(
            "M1 doit posséder cinq critères"
        )

    if len(set(CRITERES)) != 5:
        raise RuntimeError(
            "Critères M1 en double"
        )

    for critere, poids in POIDS.items():
        if (
            type(poids) not in (int, float)
            or not math.isfinite(poids)
            or poids <= 0
        ):
            raise RuntimeError(
                f"Poids invalide : {critere}"
            )

    if not math.isclose(
        math.fsum(POIDS.values()),
        1.0,
        rel_tol=0.0,
        abs_tol=1e-12,
    ):
        raise RuntimeError(
            "La somme des poids doit être 1"
        )


# ============================================================
# 4. VALIDATION DU NOYAU
# ============================================================

def verifier_noyau() -> None:
    """Vérifie le contrat technique V2.4."""

    verifier_configuration()

    if str(VERSION_NOYAU) != VERSION:
        raise RuntimeError(
            "Noyau incompatible : "
            f"M1={VERSION}, noyau={VERSION_NOYAU}"
        )

    if not callable(analyse_commune):
        raise RuntimeError(
            "Fonction analyser_course indisponible"
        )

    if not callable(executer):
        raise RuntimeError(
            "Fonction executer indisponible"
        )


# ============================================================
# 5. VALIDATION DU CLASSEMENT
# ============================================================

def verifier_classement(
    resultat: dict,
) -> None:
    """Contrôle les cinq positions prédites."""

    classement = resultat.get("classement")

    if not isinstance(classement, list):
        raise RuntimeError(
            "Classement M1 invalide"
        )

    statut = resultat["statut"]

    if statut != "ANALYSE_DISPONIBLE":
        if classement:
            raise RuntimeError(
                "Classement interdit sans "
                "analyse disponible"
            )
        return

    if len(classement) != 5:
        raise RuntimeError(
            "Cinq positions sont obligatoires"
        )

    numeros = []
    positions = []

    for cheval in classement:

        if not isinstance(cheval, dict):
            raise RuntimeError(
                "Entrée de classement invalide"
            )

        numero = cheval.get("numero")
        position = cheval.get(
            "position_predite"
        )

        if type(numero) is not int or numero <= 0:
            raise RuntimeError(
                "Numéro de cheval invalide"
            )

        if (
            type(position) is not int
            or position not in (1, 2, 3, 4, 5)
        ):
            raise RuntimeError(
                "Position prédite invalide"
            )

        numeros.append(numero)
        positions.append(position)

    if len(set(numeros)) != 5:
        raise RuntimeError(
            "Chevaux en double"
        )

    if positions != [1, 2, 3, 4, 5]:
        raise RuntimeError(
            "Positions M1 incorrectes"
        )


# ============================================================
# 6. VALIDATION DU RÉSULTAT
# ============================================================

def verifier_resultat(
    resultat: Any,
) -> dict:
    """Refuse les sorties non conformes."""

    if not isinstance(resultat, dict):
        raise RuntimeError(
            "Résultat M1 : dictionnaire attendu"
        )

    if resultat.get("moteur") != MOTEUR:
        raise RuntimeError(
            "Identité du résultat incorrecte"
        )

    if resultat.get("fige") is not False:
        raise RuntimeError(
            "FIGÉ interdit dans M1"
        )

    if resultat.get("publication") is not False:
        raise RuntimeError(
            "Publication interdite dans M1"
        )

    statut = resultat.get("statut")

    if statut not in STATUTS_AUTORISES:
        raise RuntimeError(
            f"Statut non autorisé : {statut}"
        )

    verifier_classement(resultat)

    return resultat


# ============================================================
# 7. ANALYSE SPORTIVE M1
# ============================================================

def analyser_course(course: Any) -> dict:
    """
    Analyse M1 indépendante.

    Le noyau doit valider :
    - France
    - Départ futur
    - Partants et non-partants
    - Sources documentées
    - Données suffisantes

    M1 refuse toute modification de l'entrée.
    """

    verifier_noyau()

    # Copie indépendante pour protéger la source.
    try:
        course_copie = copy.deepcopy(course)
        course_reference = copy.deepcopy(
            course_copie
        )
    except Exception as erreur:
        raise RuntimeError(
            "Impossible de copier la course"
        ) from erreur

    resultat = analyse_commune(
        course=course_copie,
        moteur=MOTEUR,
        poids=POIDS.copy(),
        champ=CHAMP,
        couverture_min=COUVERTURE_MIN,
    )

    # Le noyau ne doit pas altérer les données.
    try:
        entree_modifiee = (
            course_copie != course_reference
        )
    except Exception as erreur:
        raise RuntimeError(
            "Comparaison de l'entrée impossible"
        ) from erreur

    if type(entree_modifiee) is not bool:
        raise RuntimeError(
            "Comparaison de l'entrée ambiguë"
        )

    if entree_modifiee:
        raise RuntimeError(
            "Le noyau a modifié les données "
            "de la course"
        )

    return verifier_resultat(resultat)


# ============================================================
# 8. INTERFACE COORDINATEUR X1000
# ============================================================

def analyser_course_m1(course: Any) -> dict:
    """Point d'entrée du coordinateur."""

    return analyser_course(course)


# ============================================================
# 9. CLASSE MOTEUR
# ============================================================

class MoteurM1:
    """Moteur statistique indépendant."""

    nom = MOTEUR
    version = VERSION
    champ = CHAMP

    def __init__(self) -> None:
        verifier_noyau()

    def analyser(self, course: Any) -> dict:
        return analyser_course(course)

    def configuration(self) -> dict:
        return {
            "moteur": self.nom,
            "version": self.version,
            "champ": self.champ,
            "couverture_min": COUVERTURE_MIN,
            "criteres": list(CRITERES),
            "poids": POIDS.copy(),
            "publication": False,
            "fige_automatique": False,
        }


# ============================================================
# 10. AUTOTEST
# ============================================================

def self_test() -> bool:
    """
    Test technique sans données sportives.

    Aucune collecte.
    Aucune publication.
    Aucun FIGÉ.
    Aucune écriture.
    """

    verifier_noyau()

    moteur = MoteurM1()
    configuration = moteur.configuration()

    if configuration["moteur"] != "M1":
        raise RuntimeError(
            "Autotest : identité incorrecte"
        )

    if configuration["version"] != "2.4":
        raise RuntimeError(
            "Autotest : version incorrecte"
        )

    if len(configuration["criteres"]) != 5:
        raise RuntimeError(
            "Autotest : critères incomplets"
        )

    if not math.isclose(
        math.fsum(
            configuration["poids"].values()
        ),
        1.0,
        rel_tol=0.0,
        abs_tol=1e-12,
    ):
        raise RuntimeError(
            "Autotest : poids incohérents"
        )

    if not callable(moteur.analyser):
        raise RuntimeError(
            "Autotest : analyse indisponible"
        )

    if not callable(analyser_course_m1):
        raise RuntimeError(
            "Autotest : interface indisponible"
        )

    if configuration["publication"] is not False:
        raise RuntimeError(
            "Autotest : publication active"
        )

    if (
        configuration["fige_automatique"]
        is not False
    ):
        raise RuntimeError(
            "Autotest : FIGÉ automatique actif"
        )

    # Vérifie le refus d'une sortie invalide.
    resultat_invalide = {
        "moteur": "M1",
        "fige": False,
        "publication": False,
        "statut": "DONNEES_INSUFFISANTES",
        "classement": [
            {
                "numero": 1,
                "position_predite": 1,
            }
        ],
    }

    try:
        verifier_resultat(resultat_invalide)
    except RuntimeError:
        pass
    else:
        raise RuntimeError(
            "Autotest : classement invalide accepté"
        )

    return True


# ============================================================
# 11. EXÉCUTION
# ============================================================

def main() -> int:
    """
    Codes de sortie :
    0 : succès
    1 : erreur technique
    2 : analyse incomplète/non analysable
    """

    try:
        arguments = sys.argv[1:]

        if "--self-test" in arguments:

            if arguments != ["--self-test"]:
                raise RuntimeError(
                    "--self-test doit être utilisé seul"
                )

            self_test()

            print(
                "X1000 V2.4 — M1 : SELF-TEST OK"
            )
            print("Configuration : conforme")
            print("Noyau commun : compatible")
            print("Publication : désactivée")
            print("FIGÉ automatique : désactivé")

            return 0

        verifier_noyau()

        # Le noyau gère les arguments CLI.
        code = executer(analyser_course)

        if type(code) is not int:
            raise RuntimeError(
                "Code de sortie invalide"
            )

        if code not in (0, 1, 2):
            raise RuntimeError(
                f"Code de sortie inattendu : {code}"
            )

        return code

    except (
        RuntimeError,
        ValueError,
        TypeError,
        OSError,
        AssertionError,
    ) as erreur:

        print(
            "ERREUR TECHNIQUE M1 : "
            f"{type(erreur).__name__} : {erreur}",
            file=sys.stderr,
        )

        return 1


# ============================================================
# 12. DÉMARRAGE
# ============================================================

if __name__ == "__main__":
    sys.exit(main())
