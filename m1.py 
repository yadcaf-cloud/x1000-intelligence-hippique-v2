#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
X1000 V2.4 — M1 : STATISTIQUES ET PERFORMANCES

Moteur sportif indépendant.

CRITERES
--------
- Forme
- Régularité
- Distance
- Parcours
- Performance

PONDERATIONS
------------
20 % par critère.
Couverture minimale : 100 %.

SECURITE
--------
- Courses françaises contrôlées par le noyau.
- Départ futur contrôlé par le noyau.
- Partants et non-partants vérifiés.
- Aucune donnée sportive inventée.
- Aucun classement complet sans données suffisantes.
- Aucun FIGÉ automatique ou rétroactif.
- Aucune collecte PMU.
- Aucune publication automatique.
- Aucune écriture dans les archives.
- Aucune modification du dépôt.

COMMANDES
---------
python -m moteurs.m1 --self-test
python -m moteurs.m1 --input courses.json

Les déclarations de vérification contenues dans
les données ne prouvent pas leur authenticité.
"""

from __future__ import annotations

import copy
import math
import sys

from typing import Any


# ============================================================
# 1. IDENTITE ET CONFIGURATION
# ============================================================

MOTEUR = "M1"
VERSION = "2.4"
CHAMP = "statistiques"

COUVERTURE_MIN = 1.0

_POIDS_REFERENCE = (
    ("forme", 0.20),
    ("regularite", 0.20),
    ("distance", 0.20),
    ("parcours", 0.20),
    ("performance", 0.20),
)

POIDS = dict(_POIDS_REFERENCE)

CRITERES = tuple(
    critere for critere, _ in _POIDS_REFERENCE
)

STATUTS_AUTORISES = frozenset({
    "ANALYSE_DISPONIBLE",
    "DONNEES_INSUFFISANTES",
    "NON_ANALYSABLE",
})


# ============================================================
# 2. IMPORT DU NOYAU COMMUN
# ============================================================

if __package__:
    from . import noyau_commun
else:
    import noyau_commun


# ============================================================
# 3. VALIDATION DE LA CONFIGURATION
# ============================================================

def verifier_configuration() -> None:
    """Vérifie les paramètres indépendants de M1."""

    if MOTEUR != "M1":
        raise RuntimeError("Identité M1 incorrecte")

    if VERSION != "2.4":
        raise RuntimeError("Version M1 incorrecte")

    if CHAMP != "statistiques":
        raise RuntimeError("Champ M1 incorrect")

    if (
        type(COUVERTURE_MIN) not in (int, float)
        or not math.isfinite(COUVERTURE_MIN)
        or COUVERTURE_MIN != 1.0
    ):
        raise RuntimeError(
            "Couverture minimale M1 incorrecte"
        )

    if not isinstance(POIDS, dict):
        raise RuntimeError(
            "Pondérations M1 invalides"
        )

    if POIDS != dict(_POIDS_REFERENCE):
        raise RuntimeError(
            "Configuration des pondérations modifiée"
        )

    if len(CRITERES) != 5:
        raise RuntimeError(
            "M1 doit posséder cinq critères"
        )

    if len(set(CRITERES)) != 5:
        raise RuntimeError(
            "Critères M1 en double"
        )

    if tuple(POIDS) != CRITERES:
        raise RuntimeError(
            "Ordre des critères M1 modifié"
        )

    for critere, poids in POIDS.items():

        if (
            type(poids) not in (int, float)
            or not math.isfinite(poids)
            or poids <= 0
        ):
            raise RuntimeError(
                f"Poids invalide : {critere}"
            )

        if not math.isclose(
            poids,
            0.20,
            rel_tol=0.0,
            abs_tol=1e-12,
        ):
            raise RuntimeError(
                f"Pondération incorrecte : {critere}"
            )

    if not math.isclose(
        math.fsum(POIDS.values()),
        1.0,
        rel_tol=0.0,
        abs_tol=1e-12,
    ):
        raise RuntimeError(
            "La somme des pondérations doit être 1"
        )


# ============================================================
# 4. VALIDATION DU NOYAU COMMUN
# ============================================================

def verifier_noyau() -> None:
    """Vérifie le contrat technique X1000 V2.4."""

    verifier_configuration()

    version_noyau = getattr(
        noyau_commun,
        "VERSION",
        None,
    )

    if str(version_noyau) != VERSION:
        raise RuntimeError(
            "Noyau incompatible : "
            f"M1={VERSION}, noyau={version_noyau}"
        )

    fonctions = (
        "analyser_course",
        "executer",
        "note_valide",
    )

    for nom in fonctions:

        if not callable(
            getattr(noyau_commun, nom, None)
        ):
            raise RuntimeError(
                f"Fonction du noyau indisponible : {nom}"
            )

    statuts = getattr(
        noyau_commun,
        "STATUTS_VALIDES",
        None,
    )

    if not isinstance(
        statuts,
        (set, frozenset, tuple, list),
    ):
        raise RuntimeError(
            "Statuts du noyau absents"
        )

    if set(statuts) != STATUTS_AUTORISES:
        raise RuntimeError(
            "Statuts du noyau incompatibles"
        )


# ============================================================
# 5. VALIDATION DES NOTES
# ============================================================

def score_valide(valeur: Any) -> bool:
    """Contrôle une note sportive de 0 à 100."""

    return (
        type(valeur) in (int, float)
        and math.isfinite(valeur)
        and 0 <= valeur <= 100
    )


def couverture_valide(valeur: Any) -> bool:
    """Contrôle une couverture comprise entre 0 et 1."""

    return (
        type(valeur) in (int, float)
        and math.isfinite(valeur)
        and 0 <= valeur <= 1
    )


# ============================================================
# 6. VALIDATION DES CHEVAUX ANALYSES
# ============================================================

def verifier_analyses(resultat: dict) -> dict:
    """Vérifie les chevaux et leurs scores."""

    analyses = resultat.get("chevaux_analyses")

    if not isinstance(analyses, list):
        raise RuntimeError(
            "Liste des chevaux analysés invalide"
        )

    numeros = set()
    correspondance = {}

    for analyse in analyses:

        if not isinstance(analyse, dict):
            raise RuntimeError(
                "Analyse de cheval invalide"
            )

        numero = analyse.get("numero")
        nom = analyse.get("nom")
        score = analyse.get("score")
        couverture = analyse.get("couverture")

        if (
            type(numero) is not int
            or numero <= 0
            or numero in numeros
        ):
            raise RuntimeError(
                "Numéro de cheval analysé invalide"
            )

        numeros.add(numero)

        if (
            not isinstance(nom, str)
            or not nom.strip()
        ):
            raise RuntimeError(
                "Nom de cheval analysé invalide"
            )

        if not couverture_valide(couverture):
            raise RuntimeError(
                "Couverture statistique invalide"
            )

        if score is not None:

            if not score_valide(score):
                raise RuntimeError(
                    "Score statistique invalide"
                )

            if not math.isclose(
                couverture,
                1.0,
                rel_tol=0.0,
                abs_tol=1e-6,
            ):
                raise RuntimeError(
                    "Score M1 sans couverture complète"
                )

        if analyse.get("admissible") is not (
            score is not None
        ):
            raise RuntimeError(
                "Admissibilité M1 incohérente"
            )

        correspondance[numero] = analyse

    return correspondance


# ============================================================
# 7. VALIDATION DES CLASSEMENTS
# ============================================================

def verifier_classement(
    resultat: dict,
    analyses: dict,
) -> None:
    """Contrôle les classements complets et partiels."""

    statut = resultat["statut"]

    classement = resultat.get("classement")
    partiel = resultat.get("classement_partiel")

    if not isinstance(classement, list):
        raise RuntimeError(
            "Classement M1 invalide"
        )

    if not isinstance(partiel, list):
        raise RuntimeError(
            "Classement partiel M1 invalide"
        )

    if statut == "ANALYSE_DISPONIBLE":

        if len(classement) != 5 or partiel:
            raise RuntimeError(
                "Cinq positions M1 obligatoires"
            )

    elif statut == "DONNEES_INSUFFISANTES":

        if classement or len(partiel) >= 5:
            raise RuntimeError(
                "Classement partiel incohérent"
            )

    elif classement or partiel:
        raise RuntimeError(
            "Classement interdit pour course non analysable"
        )

    for champ in ("classement", "classement_partiel"):

        numeros = set()

        for rang, cheval in enumerate(
            resultat[champ],
            start=1,
        ):

            if not isinstance(cheval, dict):
                raise RuntimeError(
                    "Entrée de classement invalide"
                )

            numero = cheval.get("numero")
            position = cheval.get("position_predite")

            if (
                type(numero) is not int
                or numero not in analyses
                or numero in numeros
            ):
                raise RuntimeError(
                    "Cheval classé invalide ou en double"
                )

            numeros.add(numero)

            if type(position) is not int or position != rang:
                raise RuntimeError(
                    "Position prédite invalide"
                )

            analyse = analyses[numero]
            score = cheval.get("score")

            if not score_valide(score):
                raise RuntimeError(
                    "Score de classement invalide"
                )

            if score != analyse["score"]:
                raise RuntimeError(
                    "Score de classement incohérent"
                )

            if cheval.get("nom") != analyse["nom"]:
                raise RuntimeError(
                    "Nom du cheval classé incohérent"
                )

            if (
                "score_m1" in cheval
                and cheval["score_m1"] != score
            ):
                raise RuntimeError(
                    "Score spécifique M1 incohérent"
                )


# ============================================================
# 8. VALIDATION COMPLETE DU RESULTAT
# ============================================================

def verifier_resultat(resultat: Any) -> dict:
    """Refuse les sorties non conformes du noyau."""

    if not isinstance(resultat, dict):
        raise RuntimeError(
            "Résultat M1 : dictionnaire attendu"
        )

    if resultat.get("moteur") != MOTEUR:
        raise RuntimeError(
            "Identité du résultat incorrecte"
        )

    if str(resultat.get("version")) != VERSION:
        raise RuntimeError(
            "Version du résultat incompatible"
        )

    if resultat.get("fige") is not False:
        raise RuntimeError(
            "FIGÉ interdit dans M1"
        )

    if resultat.get("publication") is not False:
        raise RuntimeError(
            "Publication interdite dans M1"
        )

    statut = resultat.get("statut")

    if statut not in STATUTS_AUTORISES:
        raise RuntimeError(
            f"Statut non autorisé : {statut}"
        )

    analyses = verifier_analyses(resultat)

    verifier_classement(resultat, analyses)

    return resultat


# ============================================================
# 9. ANALYSE SPORTIVE INDEPENDANTE M1
# ============================================================

def analyser_course(course: Any) -> dict:
    """
    Analyse M1 indépendante.

    Le noyau commun contrôle la course et
    calcule les scores documentés.

    M1 refuse les modifications des données
    transmises au noyau.
    """

    verifier_noyau()

    try:
        course_copie = copy.deepcopy(course)
        course_reference = copy.deepcopy(course_copie)
    except Exception as erreur:
        raise RuntimeError(
            "Impossible de copier la course"
        ) from erreur

    resultat = noyau_commun.analyser_course(
        course=course_copie,
        moteur=MOTEUR,
        poids=POIDS.copy(),
        champ=CHAMP,
        couverture_min=COUVERTURE_MIN,
    )

    try:
        comparaison = (
            course_copie == course_reference
        )
    except Exception as erreur:
        raise RuntimeError(
            "Comparaison de l'entrée impossible"
        ) from erreur

    if type(comparaison) is not bool:
        raise RuntimeError(
            "Comparaison de l'entrée ambiguë"
        )

    if not comparaison:
        raise RuntimeError(
            "Le noyau a modifié les données de la course"
        )

    return verifier_resultat(resultat)


# ============================================================
# 10. INTERFACE COORDINATEUR X1000
# ============================================================

def analyser_course_m1(course: Any) -> dict:
    """Point d'entrée explicite du coordinateur."""
    return analyser_course(course)


# ============================================================
# 11. CLASSE MOTEUR M1
# ============================================================

class MoteurM1:
    """Moteur statistique indépendant M1."""

    nom = MOTEUR
    version = VERSION
    champ = CHAMP

    def __init__(self) -> None:
        verifier_noyau()

    def analyser(self, course: Any) -> dict:
        return analyser_course(course)

    def configuration(self) -> dict:
        return {
            "moteur": MOTEUR,
            "version": VERSION,
            "champ": CHAMP,
            "couverture_min": COUVERTURE_MIN,
            "criteres": list(CRITERES),
            "poids": POIDS.copy(),
            "publication": False,
            "fige_automatique": False,
        }


# ============================================================
# 12. AUTOTEST TECHNIQUE M1
# ============================================================

def self_test() -> bool:
    """
    Vérifie la configuration et les contrôles.

    Aucun téléchargement.
    Aucune collecte PMU.
    Aucune publication.
    Aucun FIGÉ.
    Aucune écriture d'archives.
    """

    verifier_noyau()

    moteur = MoteurM1()
    configuration = moteur.configuration()

    if configuration["moteur"] != "M1":
        raise RuntimeError(
            "Autotest : identité incorrecte"
        )

    if configuration["version"] != "2.4":
        raise RuntimeError(
            "Autotest : version incorrecte"
        )

    if len(configuration["criteres"]) != 5:
        raise RuntimeError(
            "Autotest : critères incomplets"
        )

    if not math.isclose(
        math.fsum(configuration["poids"].values()),
        1.0,
        rel_tol=0.0,
        abs_tol=1e-12,
    ):
        raise RuntimeError(
            "Autotest : pondérations incohérentes"
        )

    if not callable(moteur.analyser):
        raise RuntimeError(
            "Autotest : analyse indisponible"
        )

    if not callable(analyser_course_m1):
        raise RuntimeError(
            "Autotest : interface indisponible"
        )

    if configuration["publication"] is not False:
        raise RuntimeError(
            "Autotest : publication active"
        )

    if configuration["fige_automatique"] is not False:
        raise RuntimeError(
            "Autotest : FIGÉ automatique actif"
        )

    resultat_invalide = {
        "moteur": "M1",
        "version": "2.4",
        "fige": False,
        "publication": False,
        "statut": "DONNEES_INSUFFISANTES",
        "chevaux_analyses": [],
        "classement": [
            {
                "numero": 1,
                "position_predite": 1,
            }
        ],
        "classement_partiel": [],
    }

    try:
        verifier_resultat(resultat_invalide)
    except RuntimeError:
        pass
    else:
        raise RuntimeError(
            "Autotest : classement invalide accepté"
        )

    return True


# ============================================================
# 13. EXECUTION SECURISEE
# ============================================================

def main() -> int:
    """
    Codes de sortie :
    0 : analyse disponible ou autotest réussi
    1 : erreur technique
    2 : données insuffisantes / non analysable
    """

    try:
        arguments = sys.argv[1:]

        if "--self-test" in arguments:

            if arguments != ["--self-test"]:
                raise RuntimeError(
                    "--self-test doit être utilisé seul"
                )

            self_test()

            print("X1000 V2.4 — M1")
            print("SELF-TEST : OK")
            print("Configuration : conforme")
            print("Noyau commun : interface compatible")
            print("Critères : 5")
            print("Pondérations : 20 % chacune")
            print("Couverture minimale : 100 %")
            print("Collecte PMU : aucune")
            print("Publication : désactivée")
            print("FIGÉ automatique : désactivé")
            print("Archives : aucune modification")

            return 0

        verifier_noyau()

        code = noyau_commun.executer(
            analyser_course
        )

        if type(code) is not int or code not in (0, 1, 2):
            raise RuntimeError(
                "Code de sortie du noyau invalide"
            )

        return code

    except Exception as erreur:

        print(
            "ERREUR TECHNIQUE M1 : "
            f"{type(erreur).__name__} : {erreur}",
            file=sys.stderr,
        )

        return 1


# ============================================================
# 14. DEMARRAGE
# ============================================================

if __name__ == "__main__":
    sys.exit(main())
